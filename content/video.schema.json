{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamillosantos.github.io/painel-de-performance-do-kitchen-ai/content/video.schema.json",
  "title": "Kitchen AI Video Content Passport",
  "description": "Um registro por vídeo. Campos desconhecidos devem ser omitidos ou null; nunca inferir direitos, atribuição, autoria ou métricas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "status", "rights_status"],
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "slug": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "thumbnail": {"type": ["string", "null"], "format": "uri-reference"},
    "source": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "channel": {"type": ["string", "null"]},
    "author": {"type": ["string", "null"]},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "language": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "content_type": {"type": ["string", "null"]},
    "duration": {"type": ["string", "null"], "description": "ISO 8601 (ex.: PT4M30S) quando validado."},
    "native_media_url": {"type": ["string", "null"], "format": "uri"},
    "embed_url": {"type": ["string", "null"], "format": "uri"},
    "entities": {"type": ["array", "null"], "items": {"type": "string"}},
    "ingredients": {"type": ["array", "null"], "items": {"type": "string"}},
    "techniques": {"type": ["array", "null"], "items": {"type": "string"}},
    "dish": {"type": ["string", "null"]},
    "chef": {"type": ["string", "null"]},
    "restaurant": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "cluster": {"type": ["string", "null"]},
    "pillar": {"type": ["string", "null"]},
    "season": {"type": ["string", "null"]},
    "episode": {"type": ["string", "null"]},
    "rights_status": {"enum": ["UNKNOWN", "REQUIRES_VERIFICATION", "OWNED", "LICENSED", "OFFICIAL_EMBED_ALLOWED", "PUBLIC_DOMAIN"]},
    "attribution": {"type": ["string", "null"]},
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "evidence_url": {"type": "string", "format": "uri"},
        "evidence_note": {"type": ["string", "null"]},
        "verified_by": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "editorial_summary": {"type": ["string", "null"]},
    "seo_title": {"type": ["string", "null"]},
    "seo_description": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "status": {"enum": ["DRAFT", "REQUIRES_VERIFICATION", "READY_FOR_REVIEW", "PUBLISHED", "ARCHIVED"]},
    "generation_status": {"enum": ["NOT_REQUESTED", "QUEUED", "WAITING_CAPACITY", "GENERATING", "COMPLETED", "FAILED"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "last_verified": {"type": ["string", "null"], "format": "date-time"},
    "translation_group": {"type": ["string", "null"]}
  }
}
